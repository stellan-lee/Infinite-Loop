# Copy to .env and fill in — `docker compose` reads .env automatically.
# .env is gitignored; this .env.example is committed as a template.
# See docs/deployment.md.

# REQUIRED. Bearer token gating /api/* (the browser UI prompts for it at
# login). The container binds a non-loopback address, and the network-posture
# gate refuses to start such a bind without a token.
# Generate one with:  openssl rand -hex 32
INFLOOP_API_TOKEN=

# Optional. Minimum server log level: debug | info | warn | error.
INFLOOP_LOG_LEVEL=info

# Optional. Per-minute rate-limit ceilings for the two ingress surfaces that
# INFLOOP_API_TOKEN does not gate: webhook delivery (per trigger) and browser
# login (one global bucket). Over the limit, requests get 429. See
# docs/security.md.
INFLOOP_WEBHOOK_RATE_LIMIT=120
INFLOOP_LOGIN_RATE_LIMIT=20

# Optional. Run-level safety ceilings — a run is aborted and marked failed
# when it exceeds any of these. See docs/security.md#runaway-protection.
#   NODE_EXECUTIONS: node-execution steps per run, the runaway-loop backstop.
#                    Default 10000. 0 disables.
#   DURATION_MS:     wall-clock backstop, ms. Default 86400000 (24h). 0 disables.
#   COST_USD:        cumulative cost ceiling, US dollars. Default 0 (disabled,
#                    opt-in). Only providers that report cost count (claude CLI).
INFLOOP_MAX_RUN_NODE_EXECUTIONS=10000
INFLOOP_MAX_RUN_DURATION_MS=86400000
INFLOOP_MAX_RUN_COST_USD=0

# Optional. Process-wide cost ceiling, in US dollars, across ALL runs since
# startup — the backstop a per-run cap cannot give against a webhook storm.
# Once cumulative provider-reported cost passes it, new runs are refused (503)
# and in-flight runs abort at their next costed node. Default 0 (disabled,
# opt-in). Process-lifetime and in-memory — a restart resets the total.
# See docs/security.md#runaway-protection.
INFLOOP_MAX_TOTAL_COST_USD=0

# Optional. Container resource limits — read by docker-compose.yml, NOT the
# app. They bound the host blast radius of the agent child processes a run
# spawns: a runaway run is OOM-killed inside the container instead of taking
# the host down. The compose file pins memory-plus-swap to INFLOOP_MEM_LIMIT,
# so the container gets no swap. Tune both to the host and
# INFLOOP_MAX_CONCURRENT_RUNS. See docs/configuration.md#container-resource-limits.
INFLOOP_MEM_LIMIT=4g
INFLOOP_CPUS=2.0

# Optional. Aggregate ceiling on workflow events buffered in memory across
# ALL concurrently-running runs, counted in events. The per-run buffers are
# squeezed to a fair share of this when many runs are in flight, so a burst
# of triggers cannot grow memory without bound. Default 200000.
INFLOOP_MAX_TOTAL_EVENT_BUFFER=200000

# Optional. Extra host environment variables to expose to spawned Agent /
# Script child processes. Their environment is otherwise scrubbed to a
# non-secret allowlist so untrusted, prompt-shaped code cannot read the
# server's secrets. Comma-separated exact names or PREFIX_* trailing
# wildcards, e.g. AWS_*,SSH_AUTH_SOCK for a Bedrock-backed agent or one that
# pushes over SSH. The INFLOOP_ namespace is never passed regardless.
# See docs/security.md#containment-of-executed-code.
INFLOOP_CHILD_ENV_PASSTHROUGH=

# Optional. Set to 1 to enforce per-run network egress filtering. A CLI
# provider's spawned child then has its HTTP(S) traffic routed through a
# loopback proxy that permits only the hosts named in the manifest's
# egressAllowlist (the shipped claude/codex manifests declare theirs).
# Off-allowlist requests get 403; if the proxy cannot start the run fails
# closed. Off by default — children spawn with unrestricted egress.
# See docs/security.md#per-run-egress-allowlist.
INFLOOP_EGRESS_ENFORCE=

# Optional. Scheduled-backup sidecar knobs — read by scripts/scheduled-backup.ts
# (the `backup` service in docker-compose.yml). The sidecar snapshots the data
# directory on an interval and keeps a fixed number of generations.
# INFLOOP_BACKUP_DIR is set to /backups by the compose file — a dedicated
# volume, separate from the data volume; the app also mounts it read-only and
# reads it to expose backup freshness on /api/metrics. Override it only for a
# non-Docker host run, and never to a path inside the data directory.
# See docs/backup-restore.md#automated-backups.
#   INTERVAL_HOURS: hours between snapshots. Default 24. Must be positive.
#   KEEP:           snapshot generations retained; older ones are pruned.
#                   Default 7. Must be a positive integer.
INFLOOP_BACKUP_INTERVAL_HOURS=24
INFLOOP_BACKUP_KEEP=7

# Optional. Slack incoming-webhook URL for Alertmanager. Read only by the
# observability overlay (deploy/docker-compose.observability.yml), NOT the app.
# When set, the `alertmanager` service loads deploy/alertmanager.slack.yml and
# delivers firing alerts to Slack; empty (the default) keeps the null receiver
# — alerts collect on the Alertmanager UI only. burn-in Run 2 sets this so
# Phase 3 can validate the alert *delivery* path. See docs/burn-in-run2-plan.md.
INFLOOP_ALERT_SLACK_WEBHOOK_URL=

# GitHub CI Gate: server-only credentials, never included in workflow JSON.
# Token may be a GitHub App installation access token. Keep it refreshed;
# expired/unauthorized API responses settle waiting gates as Error.
# Read permissions: Actions, Checks, Pull requests for the target repository.
# INFLOOP_GITHUB_TOKEN=
# Mandatory webhook HMAC secret. Configure the same secret in the GitHub App.
# Webhook URL: https://your-server/api/webhook/github-ci
# Subscribe to workflow_run, check_run, check_suite, pull_request.
# INFLOOP_GITHUB_WEBHOOK_SECRET=
