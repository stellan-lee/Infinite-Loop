{
  "id": "claude",
  "label": "Claude",
  "description": "spawn claude --print",
  "glyph": "⟳",
  "bin": "claude",
  "args": [
    "{dangerousArgs}",
    "--print",
    "--output-format",
    "stream-json",
    "--include-partial-messages",
    "--verbose",
    "--agent",
    "{agent}",
    "--mcp-config",
    "{mcpConfig}",
    "{prompt}"
  ],
  "dangerousArgs": ["--dangerously-skip-permissions"],
  "envPassthrough": ["ANTHROPIC_*", "CLAUDE_*"],
  "egressAllowlist": ["api.anthropic.com", "anthropic.com", "*.anthropic.com"],
  "outputFormat": "claude-stream-json",
  "promptVia": "arg"
}
