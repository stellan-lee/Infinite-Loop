{
  "id": "codex",
  "label": "Codex",
  "description": "spawn codex exec",
  "glyph": "◈",
  "bin": "codex",
  "args": ["exec", "--skip-git-repo-check", "--profile", "{profile}", "--model", "{model}", "{prompt}"],
  "homeOverrideArgs": ["-c", "allow_login_shell=false"],
  "envPassthrough": ["OPENAI_*", "CODEX_*"],
  "egressAllowlist": [
    "api.openai.com",
    "openai.com",
    "*.openai.com",
    "chatgpt.com",
    "*.chatgpt.com"
  ],
  "outputFormat": "plain",
  "promptVia": "arg"
}
