{
  "name": "infinite-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --preload ./lib/server/async-local-storage-global.ts server.ts",
    "build": "next build",
    "start": "NODE_ENV=production bun --preload ./lib/server/async-local-storage-global.ts server.ts",
    "backup": "bun scripts/backup.ts",
    "backup:scheduled": "bun scripts/scheduled-backup.ts",
    "restore": "bun scripts/restore.ts",
    "burn-in": "bun deploy/burn-in-driver.ts",
    "soak-watch": "bun deploy/burn-in-soak-watch.ts",
    "soak-load": "bun deploy/burn-in-soak-load.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xyflow/react": "^12.10.2",
    "next": "16.2.6",
    "react": "19",
    "react-dom": "19",
    "react-icons": "^5.6.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "15.11.7",
    "@playwright/test": "^1.60.0",
    "@sinonjs/fake-timers": "13.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/sinonjs__fake-timers": "8.1.5",
    "bun-types": "^1.3.13",
    "postcss": "^8.5.26",
    "typescript": "5.7.2"
  }
}
